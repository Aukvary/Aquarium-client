# Maintainer: Aukvary <aukvary@yandex.ru>
pkgname=aquarium-client
pkgver=1.0.2
pkgrel=1
pkgdesc="Interactive TUI client for Aquarium task tracker (FTXUI + gRPC)"
arch=('x86_64')
url="https://github.com/Aukvary/Aquarium-client"
license=('MIT')
depends=('abseil-cpp' 'grpc' 'protobuf')
makedepends=('cmake' 'git' 'ninja' 'nlohmann-json')
checkdepends=('gtest')
source=(
  "${pkgname}::git+${url}.git#tag=v${pkgver}"
  "ftxui-5.0.0.tar.gz::https://github.com/ArthurSonzogni/FTXUI/archive/refs/tags/v5.0.0.tar.gz"
)
sha256sums=('SKIP'
            'a2991cb222c944aee14397965d9f6b050245da849d8c5da7c72d112de2786b5b')

build() {
  cmake -B build -S "${pkgname}" -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_DISABLE_FIND_PACKAGE_ftxui=TRUE \
    -DFETCHCONTENT_SOURCE_DIR_FTXUI="$srcdir/FTXUI-5.0.0" \
    -Wno-dev
  cmake --build build
}

check() {
  ctest --test-dir build --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "${pkgname}/LICENSE" \
    "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
}
